{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "position-evaluation-case-v1.json",
  "title": "Position Coaching Evaluation Case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "label_status", "position_profile_id", "question", "documents", "expected_findings", "forbidden_output_substrings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "minLength": 1},
    "label_status": {"enum": ["DRAFT", "HUMAN_APPROVED"]},
    "position_profile_id": {"const": "backend-v1"},
    "question": {"type": "string", "minLength": 1},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "document_type", "text"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "document_type": {"enum": ["RESUME", "SELF_INTRO", "EXPERIENCE", "PORTFOLIO"]},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "expected_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["experience_type", "claim_quote", "verdict", "present_elements", "missing_elements"],
        "properties": {
          "experience_type": {"type": "string", "minLength": 1},
          "claim_quote": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["SUFFICIENT", "PARTIAL", "CLAIM_ONLY", "NOT_ASSESSABLE"]},
          "present_elements": {"type": "array", "uniqueItems": true, "items": {"enum": ["PROBLEM", "ROLE", "ACTION", "REASONING", "MECHANISM", "VERIFICATION", "RESULT"]}},
          "missing_elements": {"type": "array", "uniqueItems": true, "items": {"enum": ["PROBLEM", "ROLE", "ACTION", "REASONING", "MECHANISM", "VERIFICATION", "RESULT"]}}
        }
      }
    },
    "forbidden_output_substrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
