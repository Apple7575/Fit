{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "position-evaluation-case-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "label_status", "rubric_id", "position_context", "question", "documents", "expected_findings", "forbidden_output_substrings"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "case_id": {"type": "string", "minLength": 1},
    "label_status": {"enum": ["DRAFT", "HUMAN_APPROVED"]},
    "rubric_id": {"const": "experience-depth-v1"},
    "position_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position_name", "priority_requirements"],
      "properties": {
        "position_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "priority_requirements": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
      }
    },
    "question": {"type": "string", "minLength": 1},
    "documents": {"type": "array", "minItems": 1},
    "expected_findings": {"type": "array", "minItems": 1},
    "forbidden_output_substrings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
