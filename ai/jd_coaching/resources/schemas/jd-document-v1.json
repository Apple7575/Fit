{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jd-document-v1.json",
  "title": "JD evidence document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "company_name",
    "organization",
    "job_title",
    "source_type",
    "source_url",
    "retrieved_at",
    "published_at",
    "valid_until",
    "source_status",
    "sections"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document_id": {"type": "string", "minLength": 1},
    "company_name": {"type": "string", "minLength": 1},
    "organization": {"type": ["string", "null"]},
    "job_title": {"type": ["string", "null"]},
    "source_type": {
      "enum": ["JOB_POSTING", "OFFICIAL_JOB_DESCRIPTION", "TALENT_PROFILE"]
    },
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "retrieved_at": {"type": "string", "format": "date"},
    "published_at": {"type": ["string", "null"], "format": "date"},
    "valid_until": {"type": ["string", "null"], "format": "date"},
    "source_status": {"enum": ["ACCESSIBLE", "ARCHIVED", "UNKNOWN"]},
    "source_file_name": {"type": ["string", "null"], "minLength": 1},
    "source_file_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "section_type", "ordinal", "text"],
        "properties": {
          "section_id": {"type": "string", "minLength": 1},
          "section_type": {
            "enum": [
              "JOB_SUMMARY",
              "RESPONSIBILITY",
              "REQUIRED_QUALIFICATION",
              "PREFERRED_QUALIFICATION",
              "TALENT_VALUE",
              "OTHER"
            ]
          },
          "ordinal": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "minLength": 1},
          "source_page": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    }
  }
}
